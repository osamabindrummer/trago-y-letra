{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Contrato de extracción de Literary Eats",
  "type": "object",
  "definitions": {
    "candidate": {
      "type": "object",
      "required": [
        "candidate_id",
        "book_id",
        "author_name",
        "drink_name",
        "relationship_type_candidate",
        "relationship_detail",
        "claim_candidate",
        "source_page_pdf",
        "support_excerpt",
        "status"
      ],
      "properties": {
        "candidate_id": {
          "type": "string",
          "pattern": "^le-[0-9]{3}$"
        },
        "book_id": {
          "const": "literary-eats"
        },
        "author_name": {
          "type": "string"
        },
        "drink_name": {
          "type": "string"
        },
        "relationship_type_candidate": {
          "enum": [
            "author_documented",
            "appears_in_work",
            "compiler_claim",
            "other"
          ]
        },
        "relationship_detail": {
          "enum": [
            "prepared",
            "ordered",
            "consumed_once",
            "habitual_consumption",
            "stated_preference",
            "attributed_recipe",
            "appears_in_work",
            "compiler_claim",
            "other"
          ]
        },
        "source_page_pdf": {
          "type": "integer",
          "minimum": 1,
          "maximum": 229
        },
        "source_page_printed": {
          "type": [
            "integer",
            "null"
          ]
        },
        "support_excerpt": {
          "type": "string",
          "maxLength": 250
        },
        "status": {
          "const": "extraction_candidate"
        }
      }
    }
  },
  "notes": "support_excerpt debe contener como máximo 25 palabras; esta restricción se verifica semánticamente en scripts/validate_artifacts.js."
}
