{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["author_id", "run", "candidates", "queries_used", "unresolved_questions", "stop_reason"],
  "properties": {
    "author_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "run": { "type": "object", "required": ["model", "reasoning_effort", "executed_at", "search_rounds"], "properties": { "model": { "type": "string" }, "reasoning_effort": { "enum": ["low", "medium"] }, "executed_at": { "type": "string", "format": "date-time" }, "search_rounds": { "type": "integer", "minimum": 0, "maximum": 4 } }, "additionalProperties": false },
    "candidates": { "type": "array", "maxItems": 6, "items": { "type": "object", "required": ["drink_name_candidate", "relationship_type_candidate", "work_candidate", "claim_candidate", "why_it_matters", "confidence_candidate", "sources", "contradicting_evidence", "verification_notes", "status"], "properties": { "drink_name_candidate": { "type": "string" }, "relationship_type_candidate": { "enum": ["author_documented", "appears_in_work", "editorial_pairing", "abstinence_or_recovery"] }, "work_candidate": { "type": ["string", "null"] }, "claim_candidate": { "type": "string" }, "why_it_matters": { "type": "string" }, "confidence_candidate": { "enum": ["high", "medium", "low"] }, "sources": { "type": "array", "maxItems": 3, "items": { "type": "object", "required": ["url", "title", "author_or_publisher", "publication_date", "source_tier_candidate", "support_excerpt", "locator", "accessed_at"], "properties": { "url": { "type": "string", "format": "uri" }, "title": { "type": "string" }, "author_or_publisher": { "type": "string" }, "publication_date": { "type": ["string", "null"] }, "source_tier_candidate": { "enum": ["primary", "scholarly", "reputable_secondary", "discovery_only"] }, "support_excerpt": { "type": "string", "maxLength": 300 }, "locator": { "type": "string" }, "accessed_at": { "type": "string", "format": "date" } }, "additionalProperties": false } }, "contradicting_evidence": { "type": "array" }, "verification_notes": { "type": "array", "items": { "type": "string" } }, "status": { "const": "candidate_generated" } }, "additionalProperties": false } },
    "queries_used": { "type": "array", "items": { "type": "string" } }, "unresolved_questions": { "type": "array", "items": { "type": "string" } }, "stop_reason": { "type": "string" }
  }, "additionalProperties": false
}
