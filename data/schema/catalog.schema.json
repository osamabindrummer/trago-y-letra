{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trago-y-letra.local/schema/catalog.json",
  "type": "object",
  "required": ["authors", "works", "drinks", "recommendations", "evidence", "sources"],
  "properties": {
    "authors": { "type": "array", "items": { "$ref": "#/$defs/author" } },
    "works": { "type": "array", "items": { "$ref": "#/$defs/work" } },
    "drinks": { "type": "array", "items": { "$ref": "#/$defs/drink" } },
    "recommendations": { "type": "array", "items": { "$ref": "#/$defs/recommendation" } },
    "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } }
  },
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "date": { "type": "string", "format": "date" },
    "author": { "type": "object", "required": ["id", "slug", "canonical_name", "aliases", "country", "birth_year", "bio_es", "featured_works", "status", "reviewed_at"], "properties": { "id": { "$ref": "#/$defs/id" }, "slug": { "$ref": "#/$defs/id" }, "canonical_name": { "type": "string", "minLength": 2 }, "aliases": { "type": "array", "items": { "type": "string", "minLength": 2 } }, "country": { "type": "string", "minLength": 2 }, "birth_year": { "type": "integer", "minimum": 1000, "maximum": 2100 }, "death_year": { "type": "integer", "minimum": 1000, "maximum": 2100 }, "bio_es": { "type": "string", "minLength": 50, "maxLength": 800 }, "featured_works": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/id" } }, "status": { "enum": ["draft", "needs_review", "published", "rejected"] }, "reviewed_at": { "$ref": "#/$defs/date" } }, "additionalProperties": false },
    "work": { "type": "object", "required": ["id", "author_id", "original_title", "display_title_es", "publication_year", "language", "identifiers", "notes"], "properties": { "id": { "$ref": "#/$defs/id" }, "author_id": { "$ref": "#/$defs/id" }, "original_title": { "type": "string", "minLength": 1 }, "display_title_es": { "type": "string", "minLength": 1 }, "publication_year": { "type": "integer", "minimum": 1000, "maximum": 2100 }, "language": { "type": "string", "minLength": 2 }, "identifiers": { "type": "object" }, "notes": { "type": "string" } }, "additionalProperties": false },
    "ingredient": { "type": "object", "required": ["name", "amount", "unit"], "properties": { "name": { "type": "string", "minLength": 1 }, "amount": { "type": "number", "exclusiveMinimum": 0 }, "unit": { "type": "string", "minLength": 1 } }, "additionalProperties": false },
    "drink": { "type": "object", "required": ["id", "name_es", "aliases", "category", "alcoholic", "ingredients", "steps", "glassware", "zero_proof_alternative_id", "recipe_note"], "properties": { "id": { "$ref": "#/$defs/id" }, "name_es": { "type": "string", "minLength": 2 }, "aliases": { "type": "array", "items": { "type": "string" } }, "category": { "type": "string", "minLength": 2 }, "alcoholic": { "type": "boolean" }, "ingredients": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ingredient" } }, "steps": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "type": "string", "minLength": 3 } }, "glassware": { "type": "string", "minLength": 2 }, "garnish": { "type": "string" }, "zero_proof_alternative_id": { "$ref": "#/$defs/id" }, "recipe_note": { "type": "string" } }, "additionalProperties": false },
    "recommendation": { "type": "object", "required": ["id", "author_id", "drink_id", "relationship_type", "headline_es", "explanation_es", "confidence", "evidence_ids", "editorial_status", "reviewed_by", "reviewed_at"], "properties": { "id": { "$ref": "#/$defs/id" }, "author_id": { "$ref": "#/$defs/id" }, "work_id": { "$ref": "#/$defs/id" }, "drink_id": { "$ref": "#/$defs/id" }, "relationship_type": { "enum": ["author_documented", "appears_in_work", "editorial_pairing", "circulating_anecdote", "abstinence_or_recovery"] }, "headline_es": { "type": "string", "minLength": 5 }, "explanation_es": { "type": "string", "minLength": 40, "maxLength": 1000 }, "confidence": { "enum": ["high", "medium", "low"] }, "evidence_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } }, "editorial_status": { "enum": ["draft", "needs_review", "approved", "published", "rejected", "blocked_insufficient_evidence"] }, "reviewed_by": { "type": "string", "minLength": 2 }, "reviewed_at": { "$ref": "#/$defs/date" } }, "additionalProperties": false },
    "evidence": { "type": "object", "required": ["id", "recommendation_id", "source_id", "claim", "locator", "evidence_kind", "supports_claim", "checked_at"], "properties": { "id": { "$ref": "#/$defs/id" }, "recommendation_id": { "$ref": "#/$defs/id" }, "source_id": { "$ref": "#/$defs/id" }, "claim": { "type": "string", "minLength": 10 }, "support_excerpt": { "type": "string", "maxLength": 300 }, "locator": { "type": "string", "minLength": 2 }, "evidence_kind": { "enum": ["direct_quote", "paraphrase", "bibliographic_reference"] }, "supports_claim": { "type": "boolean" }, "checked_at": { "$ref": "#/$defs/date" } }, "additionalProperties": false },
    "source": { "type": "object", "required": ["id", "source_type", "title", "author_or_publisher", "accessed_at", "language", "reliability_tier"], "properties": { "id": { "$ref": "#/$defs/id" }, "source_type": { "type": "string", "minLength": 2 }, "title": { "type": "string", "minLength": 2 }, "author_or_publisher": { "type": "string", "minLength": 2 }, "publication_date": { "$ref": "#/$defs/date" }, "url": { "type": "string", "format": "uri" }, "isbn": { "type": "string" }, "edition": { "type": "string" }, "accessed_at": { "$ref": "#/$defs/date" }, "language": { "type": "string", "minLength": 2 }, "reliability_tier": { "enum": ["primary", "scholarly", "reputable_secondary", "discovery_only"] } }, "additionalProperties": false }
  }
}
